// Zemné a výkopové práce — Prisma schema
// Lokálne SQLite, produkcia PostgreSQL (zmeň provider + DATABASE_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Priame (unpooled) Neon pripojenie — spoľahlivé s Prisma (bez PgBouncer).
  // Vercel integrácia poskytuje DATABASE_URL_UNPOOLED; lokálne v .env.
  url       = env("DATABASE_URL_UNPOOLED")
}

model District {
  id       String    @id @default(cuid())
  name     String // "Nitra"
  slug     String    @unique // "nitra"
  code     String    @unique // oficiálny kód okresu ŠÚSR, napr. "403"
  region   String // "Nitriansky kraj"
  lat      Float? // centroid okresu pre pin na mape
  lng      Float?
  profile  Profile?
}

model Partner {
  id          String    @id @default(cuid())
  companyName String
  ico         String
  dic         String?
  icDph       String?
  billingAddr String
  contactName String?
  phone       String
  email       String // sem chodia dopyty aj faktúry
  loginEmail  String?   @unique // e-mail na partnerské prihlásenie (magic-link)
  note        String?
  profiles    Profile[] // jeden Partner môže mať viac okresov
  loginTokens PartnerLoginToken[]
  sessions    PartnerSession[]
  createdAt   DateTime  @default(now())
}

// Jednorazový magic-link token na prihlásenie partnera (ukladá sa hashovaný).
model PartnerLoginToken {
  id        String    @id @default(cuid())
  partnerId String
  partner   Partner   @relation(fields: [partnerId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Partnerská session (hash tokenu z httpOnly cookie).
model PartnerSession {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Profile {
  id             String        @id @default(cuid())
  districtId     String        @unique
  district       District      @relation(fields: [districtId], references: [id])
  partnerId      String?
  partner        Partner?      @relation(fields: [partnerId], references: [id])

  status         ProfileStatus @default(FREE)
  paidAt         DateTime?
  expiresAt      DateTime?
  freeUpdateUsed Boolean       @default(false) // 1 bezplatná aktualizácia ročne

  // Kontakt
  displayName    String? // "Bager NR s.r.o."
  logoUrl        String?
  phone          String?
  email          String? // cieľ kontaktného formulára
  facebookUrl    String?
  youtubeUrl     String?
  websiteUrl     String?
  addressLine    String?
  lat            Float?
  lng            Float?

  // O nás
  heroImageUrl   String?
  tagline        String? // "Výkopy · doprava kameniva · búranie"
  aboutText      String?
  services       Service[]
  machines       Machine[]
  gallery        GalleryItem[]
  videos         VideoItem[]
  reviews        Review[]

  metaTitle       String?
  metaDescription String?
  updatedAt       DateTime      @updatedAt
}

enum ProfileStatus {
  FREE
  PENDING_PAYMENT
  PENDING_CONTENT
  PUBLISHED
  EXPIRED
  SUSPENDED
}

model Service {
  id          String  @id @default(cuid())
  profileId   String
  title       String
  description String?
  order       Int     @default(0)
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Machine {
  id          String  @id @default(cuid())
  profileId   String
  name        String
  description String?
  imageUrl    String?
  order       Int     @default(0)
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model GalleryItem {
  id        String  @id @default(cuid())
  profileId String
  imageUrl  String
  caption   String?
  order     Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model VideoItem {
  id        String  @id @default(cuid())
  profileId String
  url       String
  title     String?
  order     Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Review {
  id        String    @id @default(cuid())
  profileId String
  author    String
  text      String
  rating    Int?
  date      DateTime?
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Lead {
  id         String   @id @default(cuid())
  districtId String?
  name       String
  email      String
  phone      String?
  message    String
  createdAt  DateTime @default(now())
  sentOk     Boolean  @default(false)
}

model Order {
  id            String   @id @default(cuid())
  contactName   String?
  companyName   String
  ico           String
  dic           String?
  icDph         String?
  billingAddr   String
  phone         String
  email         String
  districts     String // čiarkou oddelené slugy/kódy objednaných okresov
  note          String?
  termsAccepted Boolean
  createdAt     DateTime @default(now())
  handled       Boolean  @default(false)
  paidAt        DateTime?
  // Manuálna úprava ceny adminom: konečná cena s DPH. null = štandardná cena,
  // 0 = zdarma, nižšie = zľava, ľubovoľné = vlastná cena.
  overrideTotalWithVat Decimal?
  priceNote     String? // dôvod úpravy ceny (interná poznámka)
  invoices      Invoice[]
}

// Faktúry k objednávke. Predfaktúra (proforma) sa vystaví hneď po objednávke,
// ostrá (final) po označení platby ako prijatej. Obe cez Účto+ (viď lib/uctoplus.ts).
model Invoice {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id])
  type              String // "proforma" | "final"
  status            String   @default("pending") // pending | issued | paid | failed
  invoiceNumber     String   @unique // naše číslo, napr. "PF20260001" / "20260001"
  variableSymbol    String // číslice z invoiceNumber
  amountWithoutVat  Decimal
  amountWithVat     Decimal
  vatRate           Int      @default(20)
  currency          String   @default("EUR")
  uctoplusInvoiceId String? // id dokladu z Účto+ (uuid)
  uctoplusNumber    String? // číslo dokladu vrátené Účto+
  relatedProformaId String? // pri type=final → odkaz na Invoice predfaktúry
  pdfUrl            String? // ak Účto+ poskytne PDF/odkaz
  lastError         String? // posledná chyba Účto+ (pre admin retry)
  issuedAt          DateTime?
  paidAt            DateTime?
  createdAt         DateTime @default(now())
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  role         String @default("admin")
}

// Globálne texty stránok (homepage, /spolupraca, obchodné podmienky, GDPR) – editovateľné v admine
model PageContent {
  id        String   @id @default(cuid())
  key       String   @unique // "home", "spolupraca", "obchodne-podmienky", "gdpr"
  title     String?
  body      String // HTML z Tiptap
  updatedAt DateTime @updatedAt
}
